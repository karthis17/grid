<IfModule mod_expires.c>
  ExpiresActive On

  # Hashed Next.js build assets: safe to cache for 1 year
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType text/css "access plus 1 year"
</IfModule>

<IfModule mod_headers.c>
  # Next.js hashed assets and static media: safe to cache
  <FilesMatch "\.(js|css|woff2?|ttf|otf|jpe?g|png|webp|avif|svg|ico|mp4)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  # HTML files must never be cached as immutable so updates show immediately
  <FilesMatch "\.html$">
    Header set Cache-Control "public, max-age=0, must-revalidate"
  </FilesMatch>
</IfModule>

# ----------------------------------------
# Next.js static-export routing & fallback
# ----------------------------------------
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Serve existing files directly
  RewriteCond %{REQUEST_FILENAME} -f
  RewriteRule ^ - [L]

  # Serve existing directories with index.html directly
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteCond %{REQUEST_FILENAME}/index.html -f
  RewriteRule ^ - [L]

  # Never route Next.js internal assets through index.html
  RewriteRule ^_next/ - [L]

  # Block direct access to source maps in production
  RewriteRule \.map$ - [F,L]

  # Client-side routes / fallback to root index.html
  RewriteRule . /index.html [L]
</IfModule>
